# Serveur
NODE_ENV=development
PORT=3001

# Compatibilité : DEMO_MODE=true réactive le seed mock et désactive le scheduler.
# À laisser à false pour collecter les vrais tweets de @Sardoche.
# Ne contrôle PAS le choix de la base (voir DB_CLIENT).
DEMO_MODE=false

# Base de données : sqlite (défaut) ou postgres
# Si DB_CLIENT est absent et que DATABASE_URL commence par postgres://,
# PostgreSQL est sélectionné automatiquement.
DB_CLIENT=sqlite
# Chemin absolu, ou relatif au dossier backend/
SQLITE_PATH=./sardochemetre.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sardochemetre

# CORS : "*" ou une liste d'origines séparées par des virgules
CORS_ORIGIN=*

# Limitation de débit des routes d'analyse payantes, par adresse IP.
# Valeur par défaut : 10 requêtes par fenêtre de 60 secondes.
# ANALYZE_RATE_LIMIT=10
# ANALYZE_RATE_WINDOW_MS=60000
# Derrière un proxy de confiance (Railway, Render), activez un saut de proxy
# pour que req.ip utilise X-Forwarded-For. Sinon, laissez vide.
# TRUST_PROXY=1
# Clé partagée optionnelle : si définie, les routes POST d'analyse exigent
# Authorization: Bearer <clé> ou x-analyze-key: <clé>.
# ANALYZE_API_KEY=
# Compteur partagé entre instances (table analyze_rate_limits).
# ANALYZE_RATE_LIMIT_SHARED=false
# Durée du bail du scheduler, renouvelé toutes les TTL/3 (minimum 60000).
# SCHEDULER_LOCK_TTL_MS=900000

# Scheduler : démarre si DEMO_MODE=false, source valide et clé IA présente
CRON_SCHEDULE=*/5 * * * *
CRON_RUN_ON_START=false

# Fournisseur IA : opencode (standard), anthropic (historique) ou mock (tests).
# Sans AI_PROVIDER, la première clé disponible est utilisée, sinon mock.
AI_PROVIDER=opencode

# OpenCode — clé créée sur https://opencode.ai/console (oc_sk_...)
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# payg = pay-as-you-go (recommandé pour cette application).
# go = offre OpenCode Go, supportée via l'en-tête x-opencode-session.
OPENCODE_PLAN=payg
# Surcharge optionnelle de l'URL de base (sans slash final)
# OPENCODE_BASE_URL=https://opencode.ai/inference
OPENCODE_MAX_TOKENS=3000
# Session stable pour l'offre Go (générée automatiquement si vide)
# OPENCODE_SESSION=ses_...

# Anthropic (optionnel, si AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Twitter — source des tweets : profile | syndication | x | mock
# - profile    : page publique x.com, 5 derniers tweets originaux,
#                avec profil, médias, citations et compteurs (recommandé)
# - syndication: ancien flux public X (archive souvent plus ancienne)
# - x          : API X v2 (TWITTER_BEARER_TOKEN requis)
# - mock       : tweets de test (mock/tweets.json), dates recalées
# Sans TWITTER_SOURCE : mock si DEMO_MODE=true, sinon x si un token
# est présent, sinon syndication.
TWITTER_SOURCE=profile
# Nombre de tweets récupérés par le scheduler et `npm run sync`
# (1-50 ; la source profile est plafonnée à 5)
TWITTER_SYNC_LIMIT=5
# Token optionnel, requis uniquement avec TWITTER_SOURCE=x
# TWITTER_BEARER_TOKEN=...
SARDOCHE_USERNAME=Sardoche
# SARDOCHE_USER_ID=...
